# AI Security Proxy Configuration

# Application
APP_NAME=ai-security-proxy
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# LLM Provider: mock | openai | gemini | ollama
LLM_PROVIDER=mock
MOCK_LLM=true

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Policy Actions: allow | block | redact
POLICY_PII_ACTION=redact
POLICY_SECRETS_ACTION=redact
POLICY_PROMPT_INJECTION_ACTION=block
