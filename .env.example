# AI Security Proxy Configuration

# Application
APP_NAME=ai-security-proxy
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# LLM Provider: mock | openai | gemini | ollama
LLM_PROVIDER=mock
MOCK_LLM=true

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Policy Actions: allow | block | redact
POLICY_PII_ACTION=redact
POLICY_SECRETS_ACTION=redact
POLICY_PROMPT_INJECTION_ACTION=block

# --- Observability (Person 3) ---
OBSERVABILITY_DB_URL=sqlite:///./observability.db
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_RETENTION_DAYS=7
OBSERVABILITY_DEMO_MODE=false
OBSERVABILITY_ASYNC_WRITES=true
OBSERVABILITY_DEVELOPMENT_ONLY_STORE_CONTENT=false
OBSERVABILITY_API_URL=http://localhost:8001
