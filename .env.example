# --- Observability (Person 3) ---
OBSERVABILITY_DB_URL=sqlite:///./observability.db
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_RETENTION_DAYS=7
OBSERVABILITY_DEMO_MODE=false          # true = dashboard shows a "Generate demo data" button
OBSERVABILITY_ASYNC_WRITES=true        # background writer thread; proxy is never blocked
# DEVELOPMENT_ONLY - keeps content-bearing metadata keys. NEVER enable in production.
OBSERVABILITY_DEVELOPMENT_ONLY_STORE_CONTENT=false
# Dashboard -> API
OBSERVABILITY_API_URL=http://localhost:8001
